# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

test-output

# 1. Dependency Directories (Crucial for clean builds)
# We install these inside the container, so ignore local ones.
node_modules
apps/*/node_modules
libs/*/node_modules

# 2. Build Artifacts (Keep the image clean of local compilation)
dist
apps/*/dist
libs/*/dist

# 5. Git and Editor/IDE Files
.git
.gitignore
.vscode
.idea
*.log


# Python
.venv/
**/.venv/
apps/api/.venv/

__pycache__/
*.pyc
*.pyo
*.pyd

# Python tooling
.pytest_cache/
.mypy_cache/
.pyright/
.ruff_cache/

# Node (since you have app/web)
node_modules/
dist/
build/

# OS
.DS_Store
