# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

test-output

# 1. Dependency Directories (Crucial for clean builds)
# We install these inside the container, so ignore local ones.
node_modules
apps/*/node_modules
libs/*/node_modules

# 2. Build Artifacts (Keep the image clean of local compilation)
dist
apps/*/dist
libs/*/dist

# 3. Docker files themselves
Dockerfile
Dockerfile.*
docker-compose.yml # (or .yaml)

# 4. Monorepo/Package Manager Specific Files
# pnpm-lock.yaml is copied explicitly in the multi-stage build, 
# so you don't typically ignore it here unless you have a reason.
.pnpm-store

# 5. Git and Editor/IDE Files
.git
.gitignore
.vscode
.idea
*.log
