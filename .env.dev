# .env.dev - Development Environment Variables
NODE_ENV=development
HOST=0.0.0.0
PORT=3333

# Database Connection (Local host means the MongoDB service name in Docker Compose)
DB_NAME=vidiamind
DB_USER=dev_user
DB_PASS=dev_password
MONGODB_INITDB_ROOT_USERNAME=dev_user
MONGODB_INITDB_ROOT_PASSWORD=dev_password
# MONGODB_URI=mongodb://mongo:27017/vidiamind?directConnection=true
MONGODB_URI=mongodb://dev_user:dev_password@mongo:27017/vidiamind?authSource=admin&directConnection=true
COLLECTION_NAME=video_vectors

OPENROUTER_API_KEY={openrouter_key}
OPENAI_BASE_URL=https://openrouter.ai/api/v1/
OPENROUTER_MODEL=tngtech/deepseek-r1t2-chimera:free

OLLAMA_HOST=http://ollama:11434
LLM_MODEL=llama3.1
EMBED_MODEL=nomic-embed-text
